# ============================================
# PROMPTJUR - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ============================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ============================================
# Formato: postgresql://usuario:senha@host:porta/database
# Railway: copiado automaticamente do serviço PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/promptjur

# ============================================
# AUTENTICAÇÃO (OBRIGATÓRIO)
# ============================================
# Chave secreta para assinar tokens JWT — gere com: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-super-segura-min-32-caracteres

# ============================================
# OAUTH (OPCIONAL — para login via Manus)
# ============================================
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://login.manus.im
# VITE_APP_ID=seu-app-id-manus
# OWNER_OPEN_ID=seu-open-id
# OWNER_NAME=Seu Nome

# ============================================
# LLM / INTELIGÊNCIA ARTIFICIAL (OBRIGATÓRIO — escolha uma opção)
# ============================================

# OPÇÃO A: OpenAI (recomendado para implantação independente)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# OPÇÃO B: Manus Forge (funciona dentro do ecossistema Manus)
# BUILT_IN_FORGE_API_KEY=sua-chave-forge
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# VITE_FRONTEND_FORGE_API_KEY=sua-chave-frontend
# VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im

# ============================================
# APLICAÇÃO
# ============================================
NODE_ENV=production
PORT=3000

VITE_APP_TITLE=PromptJur
VITE_APP_LOGO=/logo.svg
# URL pública do app — usada em links de e-mail e compartilhamento
VITE_APP_URL=https://seu-dominio.com

# ============================================
# STRIPE — PAGAMENTOS (OPCIONAL)
# ============================================
# Obtenha em: https://dashboard.stripe.com/apikeys
# Após configurar, ative o flag "pagamentos_ativos" via painel admin
# STRIPE_SECRET_KEY=sk_live_...         (ou sk_test_... para testes)
# STRIPE_WEBHOOK_SECRET=whsec_...       (gerado no painel Stripe → Webhooks)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_... (ou pk_test_...)

# ============================================
# E-MAIL TRANSACIONAL (OPCIONAL)
# ============================================
# Resend — https://resend.com/api-keys
# Sem esta chave, e-mails são pulados silenciosamente (app continua funcionando)
# RESEND_API_KEY=re_...
# EMAIL_FROM=PromptJur <noreply@seu-dominio.com>
# (EMAIL_FROM exige domínio verificado no Resend; sem ela usa onboarding@resend.dev)

# ============================================
# MONITORAMENTO DE ERROS (OPCIONAL)
# ============================================
# Sentry — https://sentry.io
# Sem esta chave, erros são logados apenas no console
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ============================================
# ANALYTICS (OPCIONAL)
# ============================================
# Umami — https://umami.is
# VITE_ANALYTICS_ENDPOINT=https://seu-analytics.com
# VITE_ANALYTICS_WEBSITE_ID=seu-website-id

# ============================================
# NOTIFICAÇÕES PUSH (OPCIONAL)
# ============================================
# NOTIFICATION_API_URL=https://api.notificacao.com
# NOTIFICATION_API_KEY=sua-chave-notificacao
