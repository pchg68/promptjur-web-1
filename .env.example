# ============================================
# PROMPTJUR - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ============================================
# BANCO DE DADOS
# ============================================
# Formato: mysql://usuario:senha@host:porta/database
# Railway: Copiado automaticamente do serviço MySQL
# Render: Fornecido ao criar banco MySQL
DATABASE_URL=mysql://user:password@host:3306/database

# ============================================
# AUTENTICAÇÃO
# ============================================
# Chave secreta para assinar tokens JWT (gere uma aleatória segura)
# Exemplo: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-super-segura-aqui-min-32-caracteres

# ============================================
# OAUTH (OPCIONAL - Para usar login Manus)
# ============================================
# Se você quiser manter o OAuth do Manus temporariamente
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://login.manus.im
# VITE_APP_ID=seu-app-id-manus
# OWNER_OPEN_ID=seu-open-id
# OWNER_NAME=Seu Nome

# ============================================
# LLM / INTELIGÊNCIA ARTIFICIAL
# ============================================

# OPÇÃO 1: OpenAI (Recomendado para produção)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# OPÇÃO 2: Manus LLM (Temporário - funciona apenas dentro do Manus)
# BUILT_IN_FORGE_API_KEY=sua-chave-manus
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# VITE_FRONTEND_FORGE_API_KEY=sua-chave-frontend
# VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im

# ============================================
# APLICAÇÃO
# ============================================
NODE_ENV=production
PORT=3000

# Informações da aplicação
VITE_APP_TITLE=PromptJur
VITE_APP_LOGO=/logo.svg

# ============================================
# STRIPE (OPCIONAL - Para pagamentos)
# ============================================
# Obtenha em: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# ANALYTICS (OPCIONAL)
# ============================================
# VITE_ANALYTICS_ENDPOINT=https://seu-analytics.com
# VITE_ANALYTICS_WEBSITE_ID=seu-website-id

# ============================================
# NOTIFICAÇÕES (OPCIONAL)
# ============================================
# Para enviar notificações ao proprietário
# NOTIFICATION_API_URL=https://api.notificacao.com
# NOTIFICATION_API_KEY=sua-chave-notificacao
